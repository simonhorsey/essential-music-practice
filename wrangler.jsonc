{
  // Cloudflare Workers static-assets deploy, same shape as the LearningForSuccess site.
  // Build command: python3 build.py     Deploy command: npx wrangler deploy
  "name": "essentialmusicpractice",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // "none" keeps the old .html addresses exactly as they were on Solo Build It.
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
